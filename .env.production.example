# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-redis-password-here
REDIS_DB=0

# Document Service Configuration (Java Spring Boot API)
# Supports: PDF, HWP, HWPX, DOC, DOCX, XLS, XLSX, PPT, PPTX
DOCUMENT_SERVICE_URL=http://document-service:8081
HWP_SERVICE_URL=http://document-service:8081

# Model Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_MODEL=mlx-community/Qwen3-30B-A3B-4bit
MODEL_DIR=/app/model

# Application Configuration
DATA_DIR=/app/data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# File Upload Limits
# Maximum file size for PDF/HWP uploads (in MB)
# Consider increasing for production if needed (e.g., 200 for large documents)
MAX_FILE_SIZE_MB=100

# Performance Optimization
# For production, consider enabling question generation for better UX
# Set to 'true' for auto-generated questions (slower startup but better autocomplete)
# Set to 'false' for fast startup (LLM loads on first request)
ENABLE_QUESTION_GENERATION=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info

# Security (add these for production)
# SECRET_KEY=your-secret-key-here
# API_KEY=your-api-key-here
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Monitoring (optional)
GRAFANA_PASSWORD=your-grafana-password-here

# Docker Registry (optional)
# DOCKER_REGISTRY=your-registry.com/your-org
