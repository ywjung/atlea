# Production Environment Variables
# Copy this file to .env.production and fill in the values

# PostgreSQL Configuration (primary database - required)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://chatbot_user:YOUR_STRONG_PASSWORD@postgres:5432/chatbot
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD

# Document Service Configuration (Java Spring Boot API)
# Supports: PDF, HWP, HWPX, DOC, DOCX, XLS, XLSX, PPT, PPTX
DOCUMENT_SERVICE_URL=http://document-service:8081
HWP_SERVICE_URL=http://document-service:8081

# Model Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_MODEL=mlx-community/Qwen3-30B-A3B-4bit
MODEL_DIR=/app/model

# Application Configuration
DATA_DIR=/app/data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# File Upload Limits
# Maximum file size for PDF/HWP uploads (in MB)
# Consider increasing for production if needed (e.g., 200 for large documents)
MAX_FILE_SIZE_MB=100

# Performance Optimization
# For production, consider enabling question generation for better UX
# Set to 'true' for auto-generated questions (slower startup but better autocomplete)
# Set to 'false' for fast startup (LLM loads on first request)
ENABLE_QUESTION_GENERATION=true

# Server Configuration
HOST=0.0.0.0
PORT=8085
WORKERS=4
LOG_LEVEL=info

# Environment
ENV=production
DEBUG=false

# Security - REQUIRED for production
# Generate keys: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars
SECRET_KEY=your-secret-key-here-min-32-chars
REQUIRE_HTTPS=true

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Request Timeouts (seconds)
REQUEST_TIMEOUT=300
KEEPALIVE_TIMEOUT=5

# Logging
LOG_FILE=/var/log/chatbot/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# Monitoring (optional)
GRAFANA_PASSWORD=your-grafana-password-here

# Docker Registry (optional)
# DOCKER_REGISTRY=your-registry.com/your-org
