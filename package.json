{
  "name": "chatbot-redis",
  "version": "2.2.0",
  "description": "AI Chatbot with Redis backend and ES6 modular frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint static/js --ext .js",
    "format": "prettier --write \"static/js/**/*.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report tests/e2e-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@vitejs/plugin-legacy": "^5.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "vite": "^5.0.0",
    "vite-plugin-html": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
