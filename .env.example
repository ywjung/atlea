# PostgreSQL Configuration (primary database - required)
# Docker 환경: docker-compose의 environment에서 DATABASE_URL을 오버라이드
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://chatbot_user:chatbot_secret@localhost:5432/chatbot
POSTGRES_PASSWORD=chatbot_secret

# Document Service Configuration (Java Spring Boot API)
# Supports: PDF, HWP, HWPX, DOC, DOCX, XLS, XLSX, PPT, PPTX
DOCUMENT_SERVICE_URL=http://localhost:8081
HWP_SERVICE_URL=http://localhost:8081  # Legacy compatibility - same as DOCUMENT_SERVICE_URL

# Model Configuration
# KURE-v1: Korean Universal Representation Embeddings (1024-dim)
# Optimized for Korean language semantic search
EMBEDDING_MODEL=nlpai-lab/KURE-v1

# LLM Model Selection (choose based on available RAM):
# Production (default, ~20GB RAM): mlx-community/Qwen3-30B-A3B-4bit
# Lightweight (~2GB RAM): mlx-community/Qwen2.5-3B-Instruct-4bit
# Ultra-light (~1.5GB RAM): mlx-community/Qwen2.5-1.5B-Instruct-4bit
LLM_MODEL=mlx-community/Qwen3-30B-A3B-4bit

# Model storage directory
MODEL_DIR=./model

# Application Configuration
DATA_DIR=./data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# File Upload Limits
# Maximum file size for document uploads (in MB)
MAX_FILE_SIZE_MB=100

# Performance Optimization
# Set to 'true' to enable background question generation (slower startup)
# Set to 'false' for fast startup (LLM loads on first request)
ENABLE_QUESTION_GENERATION=false

# Hybrid RAG Configuration
# Tavily API for web search integration
# Get your free API key at: https://tavily.com
# Leave empty to disable web search (local documents only)
TAVILY_API_KEY=

# Context7 API for official docs search
# Get your API key at: https://context7.com
# Leave empty to disable docs search
CONTEXT7_API_KEY=

# Server Configuration
HOST=0.0.0.0
# Docker 환경: .env의 PORT 값이 컨테이너 내부/외부 포트로 사용됨
PORT=8085

# CORS Configuration
# SECURITY: Restrict allowed origins in production
# Comma-separated list of allowed origins (e.g., "http://localhost:3000,https://example.com")
# DO NOT use "*" in production
CORS_ORIGINS=http://localhost:8085,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# JWT Security Configuration
# CRITICAL: Generate a strong secret key for production!
# Use: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Minimum 32 characters required
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# JWT Token Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Account Configuration
# SECURITY: Set a strong password for the default admin account
# If not set, a random password will be generated and saved to .admin_initial_password
# DO NOT use weak passwords like "admin", "password", "Admin123!@#", etc.
ADMIN_DEFAULT_EMAIL=admin@admin.com
ADMIN_DEFAULT_USERNAME=관리자
ADMIN_DEFAULT_PASSWORD=

# Rate Limiting Configuration
# SECURITY: Rate limits are enforced per-endpoint for security
# Login: 10 requests per 5 minutes
# Register: 5 requests per hour
# API: 60 requests per minute
# Password reset: 5 requests per hour
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ClamAV Antivirus Configuration
# ClamAV daemon (clamd) host and port for virus scanning
# Docker 환경: docker-compose가 CLAMAV_HOST=clamav 으로 자동 오버라이드
# Production: Set to your ClamAV server address
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
