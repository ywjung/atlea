# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Document Service Configuration (Java Spring Boot API)
# Supports: PDF, HWP, HWPX, DOC, DOCX, XLS, XLSX, PPT, PPTX
DOCUMENT_SERVICE_URL=http://localhost:8081
HWP_SERVICE_URL=http://localhost:8081

# Model Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_MODEL=mlx-community/Qwen3-30B-A3B-4bit
MODEL_DIR=./model

# Application Configuration
DATA_DIR=./data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# File Upload Limits
# Maximum file size for PDF/HWP uploads (in MB)
MAX_FILE_SIZE_MB=100

# Performance Optimization
# Set to 'true' to enable background question generation (slower startup)
# Set to 'false' for fast startup (LLM loads on first request)
ENABLE_QUESTION_GENERATION=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
