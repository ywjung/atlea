# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Document Service Configuration (Java Spring Boot API)
# Supports: PDF, HWP, HWPX, DOC, DOCX, XLS, XLSX, PPT, PPTX
DOCUMENT_SERVICE_URL=http://localhost:8081
HWP_SERVICE_URL=http://localhost:8081  # Legacy compatibility - same as DOCUMENT_SERVICE_URL

# Model Configuration
# KURE-v1: Korean Universal Representation Embeddings (1024-dim)
# Optimized for Korean language semantic search
EMBEDDING_MODEL=nlpai-lab/KURE-v1

# LLM Model Selection (choose based on available RAM):
# Production (default, ~20GB RAM): mlx-community/Qwen3-30B-A3B-4bit
# Lightweight (~2GB RAM): mlx-community/Qwen2.5-3B-Instruct-4bit
# Ultra-light (~1.5GB RAM): mlx-community/Qwen2.5-1.5B-Instruct-4bit
LLM_MODEL=mlx-community/Qwen3-30B-A3B-4bit

# Model storage directory
MODEL_DIR=./model

# Application Configuration
DATA_DIR=./data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# File Upload Limits
# Maximum file size for document uploads (in MB)
MAX_FILE_SIZE_MB=100

# Performance Optimization
# Set to 'true' to enable background question generation (slower startup)
# Set to 'false' for fast startup (LLM loads on first request)
ENABLE_QUESTION_GENERATION=false

# Hybrid RAG Configuration
# Tavily API for web search integration
# Get your free API key at: https://tavily.com
# Leave empty to disable web search (local documents only)
TAVILY_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# JWT Security Configuration
# CRITICAL: Generate a strong secret key for production!
# Use: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Minimum 32 characters required
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# JWT Token Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
