# ===================================
# 프로덕션 환경 설정
# ===================================
# 사용법: 프로덕션 배포 시 이 파일을 .env로 복사

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Model Configuration
EMBEDDING_MODEL=nlpai-lab/KURE-v1
LLM_MODEL=mlx-community/Qwen3-30B-A3B-4bit
MODEL_DIR=./model

# Application Configuration
DATA_DIR=./data
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=WARNING
LOG_FILE=/var/log/chatbot/server.log

# Environment (프로덕션)
ENV=production
DEBUG=false

# CORS Configuration (실제 도메인으로 변경 필요)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting (프로덕션에서 활성화)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Request Timeouts (seconds)
REQUEST_TIMEOUT=300
KEEPALIVE_TIMEOUT=5

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=50

# v2.2.0 Feature Flags
ENABLE_AUTHENTICATION=true
ENABLE_API_KEYS=true
ENABLE_ADVANCED_FILTERS=true

# JWT Settings (프로덕션용)
# 생성됨: 2025-12-27
JWT_SECRET_KEY=571ad3e288bdd1a01e9b017ed9d556c7f4c82c02a66d72a417d9d98afd57b7c2
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security - General Secret Key (프로덕션용)
SECRET_KEY=a431cb159e2a501b00aa952702d33da72b1f6565e6e88d9fad02d223bb270874

# Security Settings (강화된 보안)
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=3
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
