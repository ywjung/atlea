    <!-- CRITICAL: Force progress bar styles (bypass cache) -->
    <style>
        .progress-bar-wrapper {
            display: flex !important;
            flex-direction: column !important;
            gap: 2rem !important;
            position: relative !important;
            z-index: 1 !important;
        }

        .progress-bar-container {
            position: relative !important;
            z-index: 10 !important;
        }

        .progress-bar {
            width: 100% !important;
            height: 100px !important;
            background: #cbd5e1 !important;
            border-radius: 12px !important;
            overflow: hidden !important;
            position: relative !important;
            box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.15) !important;
            border: 3px solid #94a3b8 !important;
            z-index: 10 !important;
        }

        .progress-bar-fill {
            height: 100% !important;
            min-width: 10% !important;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 50%, #f093fb 100%) !important;
            background-size: 200% 100% !important;
            border-radius: 12px !important;
            transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
            position: relative !important;
            overflow: visible !important;
            box-shadow: 0 4px 16px rgba(102, 126, 234, 0.5) !important;
            animation: gradientShift 3s ease infinite !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            z-index: 20 !important;
        }

        .progress-bar-text {
            position: relative !important;
            z-index: 30 !important;
            font-size: 3rem !important;
            font-weight: 800 !important;
            color: white !important;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4) !important;
            letter-spacing: 2px !important;
            white-space: nowrap !important;
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        .progress-stats {
            display: flex !important;
            justify-content: center !important;
            gap: 1.5rem !important;
            position: relative !important;
            z-index: 5 !important;
            margin-top: 2rem !important;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Fix modal overflow to prevent progress bar clipping */
        .reindex-progress-modal {
            overflow: visible !important;
            max-height: none !important;
            min-height: fit-content !important;
        }

        .reindex-progress-content {
            overflow: visible !important;
            padding: 2.5rem !important;
        }

        .progress-card {
            overflow: visible !important;
        }

        /* Force progress bar dimensions with ID selectors (highest specificity) */
        #reindexProgressModal {
            overflow: visible !important;
        }

        #reindexProgressModal .modal-content {
            overflow: visible !important;
            max-height: none !important;
            height: auto !important;
        }

        #reindexProgressModal .progress-bar {
            height: 100px !important;
            min-height: 100px !important;
        }

        #reindexProgressModal .progress-bar-fill {
            height: 100px !important;
            min-height: 100px !important;
        }

        #reindexProgressPercent {
            font-size: 3rem !important;
            line-height: 1 !important;
        }
    </style>

